# =============================================================================
# QuadSSO — REQUIRED
# =============================================================================

# From your Authentik OAuth2/OpenID provider.
# CLIENT_SECRET and REDIRECT_URI are consumed via config/services.php.
AUTHENTIK_CLIENT_ID=your-client-id
AUTHENTIK_CLIENT_SECRET=your-client-secret
AUTHENTIK_REDIRECT_URI=https://your-app.com/auth/sso/callback
AUTHENTIK_BASE_URL=https://authentik.your-domain.com

# Verifies back-channel logout token signatures.
# Only optional if you set SSO_ENABLE_SLO=false.
AUTHENTIK_JWKS_URI=https://authentik.your-domain.com/application/o/your-app/jwks/


# =============================================================================
# QuadSSO — PROVISIONING MODE (pick one)
# =============================================================================

# JIT: create users automatically on their first SSO login.
# Off by default — every authenticated IdP user who is assigned to this
# application in Authentik would get a local account.
#
# With this OFF, users must already exist locally: create them in your own
# admin tooling and let SSO_ALLOW_LEGACY_EMAIL_BINDING bind them on first login.
SSO_ENABLE_JIT_PROVISIONING=false


# =============================================================================
# QuadSSO — OPTIONAL (values shown are the package defaults)
# =============================================================================

# --- Session and revocation --------------------------------------------------
# Issue a "remember me" cookie on login. Keep this off unless you have verified
# your IdP fires back-channel logout on deactivation: a remember cookie lasts
# five years by default and survives deprovisioning.
SSO_REMEMBER_LOGIN=false

# Accept back-channel Single Logout from Authentik.
SSO_ENABLE_SLO=true

# Session revocation. Deleting session rows only ends a session on the database
# driver; Laravel Cloud defaults to `cookie`, where the session lives in the
# client's cookie and nothing server-side can be deleted. A revocation timestamp
# on the user works on every driver. Requires the QuadSSO migrations.
QUADSSO_SESSION_REVOCATION=true
QUADSSO_SESSION_REVOKED_AT_FIELD=quadsso_sessions_valid_after

# Also cycle the password hash on revoke — a second revocation path for apps
# running Laravel's auth.session middleware.
QUADSSO_CYCLE_PASSWORD_ON_REVOKE=false

# --- Login behaviour ---------------------------------------------------------
# Refresh name and email from the IdP on every login.
SSO_SYNC_ATTRIBUTES_ON_LOGIN=true
SSO_AUTO_VERIFY_EMAIL=true
SSO_REDIRECT_AFTER_LOGIN=/home
SSO_REDIRECT_AFTER_FAILURE=/login

# --- Lock out local authentication -------------------------------------------
# Block the app's own registration and password-reset routes so the IdP stays
# the only way in. Off by default. Password reset in particular is an SSO
# bypass: a provisioned user has a random password, but can reset it to one
# they know and then log in locally, outliving deactivation at the IdP.
QUADSSO_DISABLE_LOCAL_AUTH=false
QUADSSO_LOCAL_AUTH_RESPONSE=redirect
QUADSSO_LOCAL_AUTH_REDIRECT=/auth/sso

# --- Identity binding --------------------------------------------------------
# Bind a user to their IdP `sub` by email on first login, one time only, and
# only when the row has no scim_external_id and the IdP asserts email_verified.
# Set false only if your app allows email changes without re-verification.
SSO_ALLOW_LEGACY_EMAIL_BINDING=true

# --- User defaults and column names ------------------------------------------
QUADSSO_APPLY_DEFAULTS=true
QUADSSO_DEFAULT_USER_LEVEL=user
QUADSSO_DEFAULT_USER_STATUS=active
QUADSSO_USER_LEVEL_FIELD=level
QUADSSO_USER_STATUS_FIELD=status
QUADSSO_ACTIVE_STATUS_VALUE=active
QUADSSO_BLOCKED_STATUS_VALUE=blocked

# --- Management API ----------------------------------------------------------
# Opt-in POST endpoint for suspending and deleting accounts out of band.
# While disabled the route is not registered at all. Generate the key with:
#   php artisan tinker --execute="echo \Illuminate\Support\Str::random(64);"
QUADSSO_MGMT_ENABLED=false
QUADSSO_MGMT_API_KEY=
QUADSSO_MGMT_HEADER=X-QuadSSO-Key
QUADSSO_MGMT_PATH=api/quadsso-mgr
QUADSSO_MGMT_FORCE_DELETE=true
# Optional class extending NullUserLifecycleHooks, run around each action.
QUADSSO_MGMT_HOOKS=

# --- Login button ------------------------------------------------------------
# Default label for <x-quadsso::login-button />. Overridable per usage.
QUADSSO_BUTTON_LABEL="Login via SSO"

# --- Custom user model -------------------------------------------------------
QUADSSO_USER_MODEL=App\Models\User

# --- Logging -----------------------------------------------------------------
# Master switch for the info-level trace of authentication steps, authorization
# decisions and API hits. Refusals and errors are logged regardless of this.
# The trace records email addresses and IdP subject identifiers, so treat the
# output like user data and keep retention short.
QUADSSO_LOGGING=false

# Optional dedicated channel, defined in config/logging.php.
QUADSSO_LOG_CHANNEL=

# Per-category switches, if you want one stream rather than all of them.
QUADSSO_LOG_SSO_EVENTS=false
QUADSSO_LOG_SLO_EVENTS=true
QUADSSO_LOG_API_EVENTS=false
